<?xml version="1.0" encoding="utf-8"?>
<!--
    What may leave this device (Android 12+).

    Two things are held back deliberately:

    `sharedpref` holds the OAuth tokens — GallerySync's own EncryptedSharedPreferences and MSAL's
    token cache. They are encrypted with a master key in the Android Keystore, and the Keystore
    key is never part of a backup, so a restored copy could not be decrypted anyway. Signing in
    again is a clean recovery; a credential blob travelling off the device is not something to
    accept for no benefit.

    `database` holds the upload ledger, which describes *this* phone: MediaStore ids, content
    URIs, and which local files were replaced by proxies. Restored onto another handset it would
    assert those things about files that are not there. It is also fully reconstructible — the
    OneDrive listing says what is backed up, and the EXIF marker says which local files are
    proxies — so a stale copy is strictly worse than none.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
    </cloud-backup>

    <!-- Phone-to-phone transfer is still a different device, so the same reasoning holds. -->
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>

    <string name="retrieve_folder_checking">Checking what is in it…</string>
    <string name="retrieve_folder_working">Restoring %1$d of %2$d…</string>
    <string name="retrieve_folder_nothing_missing">Nothing missing — none of it needed restoring.</string>
    <string name="retrieve_folder_done">Restored %1$d. Left %2$d alone, already on this phone.</string>
    <string name="retrieve_folder_failed">Could not restore this folder: %1$s</string>
    <string name="retrieve_already_here">Already on this phone — restoring makes a second copy.</string>
    <string name="retrieve_could_not_list">Could not reach OneDrive, so this is not a list of what you have. Nothing is missing; we just could not ask.</string>
    <string name="retrieve_try_again">Try again</string>
    <!-- Always available, not only after a failure: the list is a snapshot of the drive and the
         drive changes underneath it. -->
    <string name="retrieve_refresh">Refresh</string>
    <!--
        A control, not a label. The button used to say "Restoring…" and disable itself, so a fetch
        the user started could not be stopped by the person who started it.
    -->
    <string name="retrieve_stop">Stop restoring</string>
    <!-- Shown while one file downloads: which file, and how far in. A count alone reads as a
         hang on a large video. -->
    <string name="retrieve_batch_working_file">Restoring %1$d of %2$d — %3$s, %4$d%%</string>
    <string name="retrieve_done">Back on your phone.</string>
    <string name="retrieve_failed">Could not restore this one: %1$s</string>
    <string name="retrieve_unsupported">Restoring files needs Android 10 or newer.</string>
    <string name="retrieve_gone">This file is no longer in OneDrive either, so it cannot be restored. Removed from this list.</string>
    <!-- Shown after the row itself has gone, so the disappearance has a reason attached to it. -->
    <string name="retrieve_gone_named">%1$s is no longer in OneDrive either, so it could not be restored. It has been removed from this list.</string>
    <string name="retrieve_detail">%1$s · %2$s</string>

    <!-- Gate 1: which folders to look in. -->
    <string name="sources_title">Folders to back up</string>
    <string name="sources_explain">Gallery Sync only looks in the folders you choose. Most people want DCIM, where the camera saves photos.</string>
    <!--
        Said plainly because it is the whole reason the gate exists. A phone reports around ninety
        albums, nearly all of them app caches and thumbnails, and offering all of them makes the
        album list unusable and the first upload enormous.
    -->
    <string name="sources_empty">No folders chosen yet. Nothing is backed up, scanned or changed until you pick one.</string>
    <!-- Shown on Cloud check when no source folder has been granted. Names where the control is,
         because the screen is otherwise blank for a reason the user cannot see. -->
    <string name="reconcile_no_sources">No folders chosen yet, so there is nothing to check. Pick the folders to back up in Settings.</string>
    <string name="sources_add">Add a folder</string>
    <string name="sources_remove">Remove</string>
    <string name="sources_refused">That folder cannot be used. Choose a folder rather than a whole drive.</string>
    <!--
        The reassurance that makes removing safe. Narrowing hides albums; it never forgets what is
        already backed up or what mode an album was set to.
    -->
    <string name="sources_remove_note">Removing a folder stops it being watched. Nothing already backed up is lost, and adding it again restores its settings.</string>
    <string name="sources_count">%1$s in this folder</string>

    <!-- First-run reconciliation: what OneDrive already holds. -->
    <string name="reconcile_title">Checking what is already in OneDrive</string>
    <string name="reconcile_working">Checking album %1$d of %2$d…</string>
    <string name="reconcile_photos">Photos</string>
    <string name="reconcile_videos">Videos</string>
    <!-- %1$s on this phone, %2$s already backed up, %3$s still to send. -->
    <string name="reconcile_line">%1$s on this phone · %2$s already backed up · %3$s to upload</string>
    <string name="reconcile_outstanding">About %1$s still to send.</string>
    <string name="reconcile_all_safe">Everything on this phone is already in OneDrive.</string>
    <!--
        Shown only when some albums could not be listed. Deliberately says the figures are
        incomplete rather than folding unchecked files into "not backed up" — telling someone their
        library is unprotected when it may be fine pushes them into re-uploading all of it.
    -->
    <string name="reconcile_incomplete">Could not check %1$d of your albums just now, holding %2$s. They will be checked again on the first backup, and nothing about them is assumed either way.</string>
    <string name="reconcile_retry">Check again</string>
    <string name="reconcile_no_access">Gallery Sync needs access to your photos before it can check.</string>

    <plurals name="album_count">
        <item quantity="one">%1$d album</item>
        <item quantity="other">%1$d albums</item>
    </plurals>

    <!-- Gate 2: what to do with the library already on the phone. -->
    <string name="library_title">What about the photos already on this phone?</string>
    <string name="library_per_album">Choose album by album</string>
    <string name="library_per_album_detail">Nothing happens yet. You pick what each album does on the Album Modes tab.</string>
    <string name="library_back_up_all">Back up everything</string>
    <string name="library_back_up_all_detail">Every folder you chose is copied to OneDrive. Nothing on your phone changes and no space is freed.</string>
    <string name="library_free_space">Back up and free space</string>
    <!-- Photo-heavy library: the saving is worth leading with. -->
    <string name="library_free_space_detail">Photos are replaced by smaller copies that still open in your gallery. Frees about %1$s. Video is left untouched.</string>
    <!--
        Video-heavy library: leads with what stays. Only photos shrink, so on a library that is
        mostly video "free space" invites someone to expect most of it back.
    -->
    <string name="library_free_space_detail_marginal">Only photos shrink, and most of this library is video. That frees about %1$s of %2$s — the rest stays on your phone.</string>
    <string name="library_apply">Apply</string>
    <string name="library_applied">%1$s set. You can change any of them on the Album Modes tab.</string>
    <string name="library_first_run_warning">This starts your first backup, which is the long one. It runs at the time set below.</string>

    <!-- Destination folder. -->
    <string name="destination_title">Where future backups go</string>
    <string name="destination_current">%1$s</string>
    <string name="destination_why">This is where Samsung already put yours, which is how the files above were found.</string>
    <string name="destination_change">Change</string>
    <string name="destination_dialog_title">Where new backups go</string>
    <string name="destination_label">Folder in OneDrive</string>
    <!--
        The reassurance that makes this safe to change. The previous folder stays in the search set,
        so nothing already uploaded is stranded and nothing is sent twice.
    -->
    <string name="destination_dialog_body">New photos and videos will go here. The %1$d files already backed up stay where they are, and Gallery Sync keeps looking in the old folder too, so nothing is uploaded twice.</string>
    <string name="destination_dialog_body_unknown">New photos and videos will go here. Anything already backed up stays where it is, and Gallery Sync keeps looking in the old folder too, so nothing is uploaded twice.</string>
    <string name="destination_invalid">That folder path cannot be used. Use a plain path like Pictures/Backup, with no leading or trailing slash.</string>
    <string name="destination_save">Use this folder</string>
    <string name="destination_cancel">Cancel</string>
    <string name="destination_reset">Reset to default</string>

    <!-- First backup window. -->
    <string name="first_backup_title">Your first backup</string>
    <!--
        The honest framing. This run is hours long, so saying when it will happen is more useful
        than a progress bar the user has to sit and watch.
    -->
    <string name="first_backup_explain">The first backup is the big one — everything not already in OneDrive. It starts overnight so it does not slow your phone down or eat your data during the day.</string>
    <string name="first_backup_start_label">Starts at</string>
    <string name="first_backup_charging">Only while charging</string>
    <string name="first_backup_charging_detail">A long upload on battery will flatten the phone before it finishes.</string>
    <string name="first_backup_waiting_time">Waiting until %1$s.</string>
    <string name="first_backup_waiting_charging">Waiting for you to plug the phone in.</string>
    <string name="first_backup_ready">Ready to start.</string>
    <string name="first_backup_done">Your first backup is done, so this no longer applies — new photos back up as they arrive.</string>
    <string name="first_backup_manual_note">You can always press Sync now to start immediately.</string>
    <string name="hour_label">%1$s</string>
</resources>

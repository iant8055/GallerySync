<resources>
    <string name="app_name">Gallery Sync</string>

    <!-- Tabs -->
    <string name="tab_backup">Backup</string>
    <string name="tab_onedrive">OneDrive</string>

    <!-- Sign in -->
    <string name="sign_in_prompt">Connect your OneDrive account to browse your photos and videos.</string>
    <string name="sign_in_action">Sign in with Microsoft</string>
    <string name="sign_in_signed_in">Signed in</string>
    <string name="sign_out_action">Sign out</string>
    <string name="sign_in_failed">Sign-in failed</string>
    <string name="try_again_action">Try again</string>

    <!-- Browsing -->
    <string name="browse_root">OneDrive</string>
    <string name="browse_empty_folder">This folder is empty.</string>
    <string name="retry_action">Retry</string>
    <string name="browse_folder">Folder</string>
    <plurals name="item_count">
        <item quantity="one">%d item</item>
        <item quantity="other">%d items</item>
    </plurals>

    <!-- Remote errors -->
    <string name="error_not_signed_in">Not signed in.</string>
    <string name="error_unauthorized">OneDrive rejected the sign-in. Try signing out and back in.</string>
    <string name="error_network">Can\'t reach OneDrive. Check your connection.</string>
    <string name="error_drive_full">Your OneDrive is full. Free up space to continue.</string>
    <string name="error_http">OneDrive returned an error (%1$d).</string>
    <string name="error_unknown">Something went wrong: %1$s</string>

    <!-- Media permission -->
    <string name="permission_needed_title">Gallery Sync needs access to your photos</string>
    <string name="permission_needed_detail">It reads the albums you choose so it can back them up to OneDrive. It never deletes anything.</string>
    <string name="permission_partial_title">Only some photos are shared</string>
    <string name="permission_partial_detail">Gallery Sync can currently see just the photos you picked, so a backup would be incomplete. Grant access to all photos to back up whole albums.</string>
    <string name="permission_grant_action">Grant access</string>

    <!-- Backup -->
    <string name="backup_selection_summary">%1$s selected · %2$s</string>
    <string name="backup_progress_summary">%1$d backed up · %2$d outstanding</string>
    <string name="backup_deselect_all">Deselect all</string>
    <string name="backup_select_all">Select all</string>
    <string name="backup_rescan">Rescan</string>
    <string name="backup_run_now">Back up now</string>
    <string name="backup_running">Backing up…</string>
    <string name="backup_album_summary">%1$s · %2$s</string>
    <plurals name="file_count">
        <item quantity="one">%d file</item>
        <item quantity="other">%d files</item>
    </plurals>

    <!-- Backup status -->
    <string name="backup_status_scanning">Scanning…</string>
    <string name="backup_status_uploading">Uploading…</string>
    <string name="backup_status_no_permission">No permission to read media.</string>
    <string name="backup_status_uploaded">%1$d uploaded</string>
    <string name="backup_status_skipped">%1$d already in OneDrive</string>
    <string name="backup_status_failed">%1$d failed</string>
    <string name="backup_status_remaining">%1$d still to go</string>
    <string name="backup_status_separator">, </string>

    <!-- Why a run stopped early -->
    <string name="backup_stopped_no_token">stopped: not signed in</string>
    <string name="backup_stopped_unauthorized">stopped: OneDrive rejected the sign-in</string>
    <string name="backup_stopped_drive_full">stopped: OneDrive is full</string>
    <string name="backup_stopped_network">stopped: lost connection</string>
    <string name="backup_stopped_no_media_access">stopped: no access to your photos</string>

    <!-- Sizes. Units are conventionally left untranslated, but the format is overridable. -->
    <string name="size_bytes">%1$d B</string>
    <string name="size_kilobytes">%1$d KB</string>
    <string name="size_megabytes">%1$d MB</string>
    <string name="size_gigabytes">%1$s GB</string>
</resources>

<resources>
    <string name="app_name">Gallery Sync</string>

    <!-- Tabs -->
    <string name="tab_backup">Album Modes</string>
    <!-- Unused while the OneDrive browser tab is hidden; v0.4 repurposes that screen. -->
    <string name="tab_onedrive">OneDrive</string>
    <string name="tab_settings">Settings</string>

    <!-- Settings sections -->
    <string name="settings_account">Account</string>
    <string name="settings_open_onedrive">Open OneDrive</string>
    <string name="settings_open_onedrive_detail">GallerySync does not browse your cloud files — OneDrive already does that well. Open it to find anything that is not on this phone.</string>
    <string name="settings_automatic">Automatic sync</string>
    <string name="settings_storage">Storage</string>
    <string name="settings_optimise">Optimise photos</string>

    <!--
        "Optimise" rather than "compress" or "shrink": the photo stays in the gallery and stays
        usable, which is the point. Videos are named as excluded because their absence would
        otherwise look like a bug.
    -->
    <plurals name="proxy_explainer">
        <item quantity="one">%1$d photo can be optimised. A smaller copy stays on the phone and the full-size original stays in OneDrive.</item>
        <item quantity="other">%1$d photos can be optimised. Smaller copies stay on the phone and the full-size originals stay in OneDrive.</item>
    </plurals>
    <string name="proxy_action">Optimise %1$s of photos</string>
    <string name="proxy_videos_excluded">Videos are never optimised — a lower-quality clip would fail quietly inside an editor.</string>
    <string name="proxy_none">Nothing to optimise. Photos become eligible once they are verified in OneDrive.</string>
    <string name="proxy_unsupported">Optimising photos needs Android 11 or newer.</string>
    <string name="proxy_working">Optimising…</string>
    <string name="proxy_done">Optimised %1$d photos and freed %2$s.</string>
    <string name="proxy_stopped">Stopped after %1$d photos. %2$s could not be replaced (%3$s). Nothing after it was changed.</string>
    <!-- Says plainly that nothing happened. Silence here is what made this look broken. -->
    <string name="proxy_could_not_ask">Android wouldn\'t show the permission prompt, so no photos were changed. The list has been refreshed — try again.</string>

    <!-- Sign in -->
    <string name="sign_in_prompt">Connect your OneDrive account to browse your photos and videos.</string>
    <string name="sign_in_action">Sign in with Microsoft</string>
    <string name="sign_in_signed_in">Signed in</string>
    <string name="sign_out_action">Sign out</string>
    <string name="sign_in_failed">Sign-in failed</string>
    <string name="try_again_action">Try again</string>

    <!-- Browsing -->
    <string name="browse_root">OneDrive</string>
    <string name="browse_empty_folder">This folder is empty.</string>
    <string name="retry_action">Retry</string>
    <string name="browse_folder">Folder</string>
    <string name="sort_name">Name</string>
    <string name="sort_date">Date</string>
    <string name="sort_size">Size</string>
    <string name="sort_ascending">↑</string>
    <string name="sort_descending">↓</string>
    <plurals name="item_count">
        <item quantity="one">%d item</item>
        <item quantity="other">%d items</item>
    </plurals>

    <!-- Remote errors -->
    <string name="error_not_signed_in">Not signed in.</string>
    <string name="error_unauthorized">OneDrive rejected the sign-in. Try signing out and back in.</string>
    <string name="error_network">Can\'t reach OneDrive. Check your connection.</string>
    <string name="error_local_file_missing">That file is no longer on this phone.</string>
    <string name="error_drive_full">Your OneDrive is full. Free up space to continue.</string>
    <string name="error_http">OneDrive returned an error (%1$d).</string>
    <string name="error_unknown">Something went wrong: %1$s</string>

    <!-- Media permission -->
    <string name="permission_needed_title">Gallery Sync needs access to your photos</string>
    <string name="permission_needed_detail">It reads the albums you choose so it can sync them to OneDrive. It never deletes anything.</string>
    <string name="permission_partial_title">Only some photos are shared</string>
    <string name="permission_partial_detail">Gallery Sync can currently see just the photos you picked, so a sync would be incomplete. Grant access to all photos to sync whole albums.</string>
    <string name="permission_grant_action">Grant access</string>

    <!-- Backup -->
    <string name="backup_selection_summary">%1$s selected · %2$s</string>
    <string name="backup_all_done">Everything selected is synced</string>
    <string name="backup_nothing_selected">Choose an album to sync</string>
    <!--
        "verified" matters: this is what Gallery Sync has confirmed, not what OneDrive contains.
        After a reinstall the ledger is empty and this reads 0, which would otherwise look like
        the user's whole backup had disappeared.
    -->
    <plurals name="backup_total_stored">
        <item quantity="one">%1$d file verified in OneDrive</item>
        <item quantity="other">%1$d files verified in OneDrive</item>
    </plurals>

    <!--
        Removing local copies. Deliberately NOT called sync: sync means the file stays in the
        gallery, and this is the one operation where it does not. The file is not discarded — it
        goes from two copies to one, and that one is verified in OneDrive — but from the user's
        side it leaves the gallery, so the wording says so rather than implying a tidy move.
        The trash note is not softening: space is genuinely not reclaimed until the user empties
        it, and saying otherwise would be a lie they discover later.
    -->
    <string name="backup_move_to_backup">Remove %1$s from this phone</string>

    <!--
        The whole sentence is a plural, not a plural noun dropped into a fixed template — the verb
        and pronoun have to agree too ("1 file … is … it" vs "8 files … are … them"). Languages
        with more than two plural forms, or with gendered pronouns, break even harder on that.
    -->
    <plurals name="backup_move_explainer">
        <item quantity="one">%1$d file on this phone is already verified in OneDrive. Removing it frees that space, but it will no longer appear in your gallery.</item>
        <item quantity="other">%1$d files on this phone are already verified in OneDrive. Removing them frees that space, but they will no longer appear in your gallery.</item>
    </plurals>
    <string name="backup_move_trash_note">Your OneDrive copy is checked first and is never touched. On some phones the local copy goes to your gallery\'s Recently deleted; on others it is removed straight away, so treat this as permanent on the phone.</string>
    <string name="backup_move_unsupported">Removing local copies needs Android 11 or newer.</string>
    <string name="backup_nothing_redundant">Nothing to remove yet — a file can be removed once it is verified in OneDrive.</string>
    <string name="backup_automatic">Sync automatically</string>
    <string name="backup_automatic_on">New photos sync shortly after you take them.</string>
    <string name="backup_automatic_off">Nothing syncs unless you tap Sync now.</string>
    <string name="backup_allow_metered">Use mobile data</string>
    <string name="backup_allow_metered_on">Syncs on Wi-Fi and mobile data.</string>
    <string name="backup_allow_metered_off">Wi-Fi only.</string>

    <string name="backup_deselect_all">Deselect all</string>
    <string name="backup_select_all">Select all</string>
    <string name="backup_rescan">Rescan</string>
    <string name="backup_run_now">Sync now</string>
    <string name="backup_running">Syncing…</string>
    <string name="backup_album_summary">%1$s · %2$s</string>

    <!--
        Album status is separate from the toggle on purpose. An archived album that will never
        gain another photo is finished, not unprotected — and "off" must not read as "at risk".
    -->
    <string name="album_status_complete">All synced</string>
    <string name="album_status_partial">%1$d still to sync</string>
    <string name="album_status_none">Not synced yet</string>
    <string name="album_watching">Watching for new files</string>
    <string name="album_not_watching">Not watched — nothing new expected</string>
    <plurals name="file_count">
        <item quantity="one">%d file</item>
        <item quantity="other">%d files</item>
    </plurals>

    <!-- Backup status -->
    <string name="backup_status_scanning">Scanning…</string>
    <string name="backup_status_uploading">Uploading…</string>
    <!-- Names the file and its own progress: on a 178 MB video, "3 of 12" alone looks stuck. -->
    <string name="backup_status_uploading_progress">Uploading %1$d of %2$d · %3$s · %4$d%%</string>
    <string name="backup_status_no_permission">No permission to read media.</string>
    <string name="backup_status_uploaded">%1$d uploaded</string>
    <string name="backup_status_skipped">%1$d already in OneDrive</string>
    <string name="backup_status_failed">%1$d failed</string>
    <!-- Files that left the phone. Not failures — the record is simply no longer about anything. -->
    <string name="backup_status_pruned">%1$d no longer on this phone</string>
    <string name="backup_status_remaining">%1$d still to go</string>
    <string name="backup_status_separator">, </string>

    <!-- Why a run stopped early -->
    <string name="backup_stopped_no_token">stopped: not signed in</string>
    <string name="backup_stopped_unauthorized">stopped: OneDrive rejected the sign-in</string>
    <string name="backup_stopped_drive_full">stopped: OneDrive is full</string>
    <string name="backup_stopped_network">stopped: lost connection</string>
    <string name="backup_stopped_no_media_access">stopped: no access to your photos</string>

    <!-- Sizes. Units are conventionally left untranslated, but the format is overridable. -->
    <string name="size_bytes">%1$d B</string>
    <string name="size_kilobytes">%1$d KB</string>
    <string name="size_megabytes">%1$d MB</string>
    <string name="size_gigabytes">%1$s GB</string>
</resources>
